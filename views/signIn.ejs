<!doctype html>
<html lang="pt-BR" data-bs-theme="dark">
<head>
  <%- include('./common/head.ejs', { title: 'Entrar | OTA Firmware' }) %>
</head>
<body>
<section class="login-view">
  <div class="login-shell">
    <div class="login-card">
      <div class="brand-lockup">
        <span class="brand-mark" aria-hidden="true">O</span>
        <div>
          <div class="brand-name">OTA Firmware</div>
          <div class="brand-caption">Distribuicao remota por device</div>
        </div>
      </div>

      <h1 class="login-title">Entrar</h1>
      <p class="login-subtitle">Acesse para publicar firmwares por MAC address.</p>

      <form method="post" action="/sign-in">
        <div class="mb-3">
          <label for="email" class="form-label">E-mail</label>
          <input type="email" class="form-control" id="email" name="email" placeholder="admin@ota.local" required autofocus>
        </div>

        <div class="mb-4">
          <label for="password" class="form-label">Senha</label>
          <input type="password" class="form-control" id="password" name="password" placeholder="********" required>
        </div>

        <button type="submit" class="btn btn-primary w-100">Entrar</button>
      </form>

      <div class="login-footer">
        <a href="/sign-up">Solicitar acesso</a>
      </div>
    </div>
  </div>
</section>
<%- include('./common/end.ejs') %>
</body>
</html>
