<!doctype html>
<html lang="pt-BR" data-bs-theme="dark">
<head>
  <%- include('../common/head.ejs', { title: 'Device | OTA Firmware' }) %>
</head>
<body class="app-view">
<%- include('../common/nav.ejs', { user }) %>

<main class="main-content">
  <div class="page-head">
    <div>
      <a href="/admin" class="back-link">Voltar</a>
      <h1 class="page-title"><code><%= device.mac %></code></h1>
      <p class="page-subtitle">Publique um binario e versao para este device especifico.</p>
    </div>
  </div>

  <div class="row g-3 mb-3">
    <div class="col-12 col-md-4">
      <div class="stat-card">
        <div class="stat-label">Device ID</div>
        <div class="stat-value stat-value-sm"><%= device.device_id || '-' %></div>
      </div>
    </div>
    <div class="col-12 col-md-4">
      <div class="stat-card">
        <div class="stat-label">Board</div>
        <div class="stat-value stat-value-sm"><%= device.board || '-' %></div>
      </div>
    </div>
    <div class="col-12 col-md-4">
      <div class="stat-card">
        <div class="stat-label">Ultimo IP</div>
        <div class="stat-value stat-value-sm"><%= device.last_ip || '-' %></div>
      </div>
    </div>
  </div>

  <section class="panel mb-3">
    <div class="panel-header">
      <div>
        <h2 class="panel-title">Novo firmware</h2>
        <p class="panel-subtitle">A proxima chamada de manifesto desse MAC recebera essa versao.</p>
      </div>
    </div>
    <form method="post" action="/admin/devices/<%= device.id %>/firmware" enctype="multipart/form-data" class="row g-3">
      <div class="col-12 col-md-4">
        <label class="form-label" for="version">Versao</label>
        <input class="form-control" id="version" name="version" placeholder="1.0.1" required>
      </div>
      <div class="col-12 col-md-6">
        <label class="form-label" for="firmware">Binario</label>
        <input class="form-control" id="firmware" name="firmware" type="file" accept=".bin,application/octet-stream" required>
      </div>
      <div class="col-12 col-md-2 d-flex align-items-end">
        <button class="btn btn-primary w-100" type="submit">Publicar</button>
      </div>
    </form>
  </section>

  <section class="panel">
    <div class="panel-header">
      <div>
        <h2 class="panel-title">Historico</h2>
        <p class="panel-subtitle">Firmwares publicados para este MAC.</p>
      </div>
    </div>
    <div class="table-responsive">
      <table class="table table-finora align-middle mb-0">
        <thead>
        <tr>
          <th>Versao</th>
          <th>Arquivo</th>
          <th>Tamanho</th>
          <th>Status</th>
          <th>Criado em</th>
          <th></th>
        </tr>
        </thead>
        <tbody>
        <% [...device.firmwares].sort((a, b) => new Date(b.created_at) - new Date(a.created_at)).forEach((firmware) => { %>
          <tr>
            <td><span class="badge text-bg-primary">v<%= firmware.version %></span></td>
            <td><%= firmware.original_name %></td>
            <td><%= firmware.size %> bytes</td>
            <td><%= firmware.active ? 'ativo' : 'substituido' %></td>
            <td><%= moment(firmware.created_at).tz('America/Sao_Paulo').format('DD/MM/YYYY HH:mm:ss') %></td>
            <td class="text-end">
              <button
                class="btn btn-sm btn-outline-danger"
                type="button"
                data-bs-toggle="modal"
                data-bs-target="#firmwareDeleteModal"
                data-delete-url="/admin/devices/<%= device.id %>/firmwares/<%= firmware.id %>/delete"
                data-firmware-version="<%= firmware.version %>"
                data-firmware-name="<%= firmware.original_name %>"
              >
                Excluir
              </button>
            </td>
          </tr>
        <% }) %>
        <% if (!device.firmwares.length) { %>
          <tr>
            <td colspan="6" class="text-center text-muted py-5">Nenhum firmware publicado.</td>
          </tr>
        <% } %>
        </tbody>
      </table>
    </div>
  </section>
</main>

<div class="modal fade" id="firmwareDeleteModal" tabindex="-1" aria-labelledby="firmwareDeleteModalTitle" aria-hidden="true">
  <div class="modal-dialog modal-dialog-centered">
    <div class="modal-content">
      <div class="modal-header">
        <div>
          <h1 class="modal-title fs-6" id="firmwareDeleteModalTitle">Excluir firmware</h1>
          <div class="text-secondary small mt-1">Essa ação remove o binário publicado para este device.</div>
        </div>
        <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Fechar"></button>
      </div>
      <div class="modal-body">
        <p class="mb-2">Deseja excluir o firmware abaixo?</p>
        <div class="fw-semibold" id="deleteFirmwareName">-</div>
        <div class="text-secondary small mt-1" id="deleteFirmwareVersion">-</div>
        <div class="text-danger small mt-3">
          Se ele estiver ativo, o device deixará de receber essa versão no próximo request de manifesto.
        </div>
      </div>
      <div class="modal-footer">
        <button class="btn btn-outline-secondary" type="button" data-bs-dismiss="modal">Cancelar</button>
        <form method="post" action="#" class="m-0" id="deleteFirmwareForm">
          <button class="btn btn-danger" type="submit">Confirmar exclusão</button>
        </form>
      </div>
    </div>
  </div>
</div>

<script>
  document.addEventListener('DOMContentLoaded', () => {
    const modal = document.getElementById('firmwareDeleteModal');
    const form = document.getElementById('deleteFirmwareForm');
    const name = document.getElementById('deleteFirmwareName');
    const version = document.getElementById('deleteFirmwareVersion');

    modal?.addEventListener('show.bs.modal', (event) => {
      const button = event.relatedTarget;
      form.action = button?.dataset.deleteUrl || '#';
      name.textContent = button?.dataset.firmwareName || '-';
      version.textContent = button?.dataset.firmwareVersion ? `Versao ${button.dataset.firmwareVersion}` : '-';
    });
  });
</script>

<%- include('../common/end.ejs') %>
</body>
</html>
