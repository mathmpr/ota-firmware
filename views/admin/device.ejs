<!doctype html>
<html lang="pt-BR" data-bs-theme="dark">
<head>
  <%- include('../common/head.ejs', { title: 'Device | OTA Firmware' }) %>
</head>
<body class="app-view">
<%- include('../common/nav.ejs', { user }) %>

<main class="main-content">
  <div class="page-head">
    <div>
      <a href="/admin" class="back-link">Voltar</a>
      <h1 class="page-title"><code><%= device.mac %></code></h1>
      <p class="page-subtitle">Device registrado automaticamente pelo manifesto.</p>
    </div>
  </div>

  <div class="row g-3 mb-3">
    <div class="col-12 col-md-4"><div class="stat-card"><div class="stat-label">Family ID</div><div class="stat-value stat-value-sm"><%= device.family_id || '-' %></div></div></div>
    <div class="col-12 col-md-4"><div class="stat-card"><div class="stat-label">Placa</div><div class="stat-value stat-value-sm"><%= device.board || '-' %></div></div></div>
    <div class="col-12 col-md-4"><div class="stat-card"><div class="stat-label">Ultimo IP</div><div class="stat-value stat-value-sm"><%= device.last_ip || '-' %></div></div></div>
  </div>

  <section class="panel">
    <div class="panel-header">
      <div>
        <h2 class="panel-title">Grupo de firmware</h2>
        <p class="panel-subtitle">A Family ID e a placa abaixo foram preenchidas pela ultima chamada de manifesto.</p>
      </div>
    </div>
    <% if (device.group) { %>
      <p class="mb-3">Este device pertence ao grupo <code><%= device.group.family_id %></code> / <code><%= device.group.board %></code>.</p>
      <a class="btn btn-primary" href="/admin/groups/<%= device.group.id %>">Abrir grupo</a>
    <% } else if (device.family_id && device.board) { %>
      <p class="mb-3">Criar ou localizar o grupo <code><%= device.family_id %></code> / <code><%= device.board %></code> e associar este MAC.</p>
      <form method="post" action="/admin/devices/<%= device.id %>/group"><button class="btn btn-primary" type="submit">Criar e associar grupo</button></form>
    <% } else { %>
      <p class="mb-0 text-muted">Aguardando um manifesto com Family ID e placa.</p>
    <% } %>
  </section>

  <section class="panel mt-3">
    <div class="panel-header">
      <div>
        <h2 class="panel-title">Excluir device</h2>
        <p class="panel-subtitle">O cadastro e o primeiro request salvo serao removidos. Uma nova chamada de manifesto recriara este MAC.</p>
      </div>
    </div>
    <button class="btn btn-danger" type="button" data-bs-toggle="modal" data-bs-target="#deleteDeviceModal">Excluir device</button>
  </section>
</main>

<div class="modal fade" id="deleteDeviceModal" tabindex="-1" aria-labelledby="deleteDeviceModalTitle" aria-hidden="true">
  <div class="modal-dialog modal-dialog-centered">
    <div class="modal-content">
      <div class="modal-header">
        <h1 class="modal-title fs-6" id="deleteDeviceModalTitle">Excluir device</h1>
        <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Fechar"></button>
      </div>
      <div class="modal-body">
        <p class="mb-2">Excluir o device <code><%= device.mac %></code>?</p>
        <p class="mb-0 text-danger">O proximo manifesto desse MAC criara um novo cadastro.</p>
      </div>
      <div class="modal-footer">
        <button class="btn btn-outline-secondary" type="button" data-bs-dismiss="modal">Cancelar</button>
        <form method="post" action="/admin/devices/<%= device.id %>/delete" class="m-0">
          <button class="btn btn-danger" type="submit">Continuar</button>
        </form>
      </div>
    </div>
  </div>
</div>

<%- include('../common/end.ejs') %>
</body>
</html>
